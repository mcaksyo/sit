{
  "openapi": "3.0.3",
  "info": {
    "title": "СИТ · API заказов и уведомлений",
    "version": "1.0.0",
    "description": "HTTP API лабораторной работы. После создания заказа или изменения статуса уведомление появляется асинхронно."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Заказы"
    },
    {
      "name": "Уведомления"
    }
  ],
  "paths": {
    "/api/orders": {
      "post": {
        "tags": [
          "Заказы"
        ],
        "summary": "Создать заказ",
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "customer_id",
                  "amount"
                ],
                "properties": {
                  "customer_id": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 1
                  },
                  "amount": {
                    "description": "Положительная сумма с точностью до двух знаков после точки.",
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]{1,8}(\\.[0-9]{1,2})?$"
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMinimum": true,
                        "maximum": 99999999.99,
                        "multipleOf": 0.01
                      }
                    ]
                  }
                }
              },
              "example": {
                "customer_id": 100,
                "amount": "2500.50"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Заказ создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный идентификатор клиента или сумма",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": [
          "Заказы"
        ],
        "summary": "Получить заказ",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            },
            "example": 1,
            "description": "ID заказа"
          }
        ],
        "responses": {
          "200": {
            "description": "Заказ найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Заказ не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}/status": {
      "patch": {
        "tags": [
          "Заказы"
        ],
        "summary": "Изменить статус заказа",
        "operationId": "changeOrderStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            },
            "example": 1,
            "description": "ID заказа"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "created",
                      "paid",
                      "cancelled"
                    ]
                  }
                }
              },
              "example": {
                "status": "paid"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Текущий статус сохранён в ответе",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Недопустимый статус",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Заказ не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "Уведомления"
        ],
        "summary": "Получить уведомления",
        "operationId": "listNotifications",
        "parameters": [
          {
            "name": "order_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            },
            "description": "Фильтр по ID заказа"
          }
        ],
        "responses": {
          "200": {
            "description": "Список уведомлений",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Notification"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректный идентификатор заказа",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "required": [
          "id",
          "customer_id",
          "amount",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "customer_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "amount": {
            "type": "string",
            "example": "2500.50"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "paid",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Notification": {
        "type": "object",
        "required": [
          "id",
          "order_id",
          "message",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "order_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "example": "Создан заказ №1 на сумму 2500.50"
          },
          "created_at": {
            "type": "string",
            "example": "2026-11-13 14:16:14"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
